{
  "$schema_note": "House System v1 design tokens. Single source for palette, type scale, canvases, safe zones and motion constants. house.css is derived from this file; keep them in step.",
  "system": {
    "name": "House System v1",
    "status": "ACTIVE — delegated production decision 2026-09-08 (DECISIONS.md); founders may override before Day 1",
    "applies_to": "all 84 feed posts, all 84 Stories, both accounts, all six weeks"
  },
  "canvas": {
    "feed_static":   { "w": 1080, "h": 1350, "ratio": "4:5" },
    "feed_carousel": { "w": 1080, "h": 1350, "ratio": "4:5" },
    "reel":          { "w": 1080, "h": 1920, "ratio": "9:16", "fps": 30 },
    "story":         { "w": 1080, "h": 1920, "ratio": "9:16" },
    "reel_cover_crop_for_grid": { "note": "Profile grid shows a 4:5 crop of the Reel cover. Keep the cover title inside y = 285..1635.", "y0": 285, "y1": 1635 },
    "square_safe_zone_on_feed": { "note": "Legacy 1:1 contexts crop the 4:5 canvas to the central square. Keep essential content inside y = 135..1215.", "y0": 135, "y1": 1215 }
  },
  "safe_zones_px": {
    "reel":  { "top": 250, "bottom": 420, "right": 130, "left": 60 },
    "story": { "top": 250, "bottom": 260, "right": 60,  "left": 60 }
  },
  "grid": {
    "unit": 8,
    "margin": 72,
    "gutter": 24,
    "band_top_h": 96,
    "band_bottom_h": 72,
    "radius_card": 24,
    "radius_pill": 999,
    "rule": 4
  },
  "color": {
    "ink":        "#0F1013",
    "ink_2":      "#1B1C21",
    "ink_3":      "#2A2B33",
    "paper":      "#F3EFE6",
    "paper_2":    "#E6E1D6",
    "white":      "#FFFFFF",
    "text_on_ink":            "#F3EFE6",
    "text_on_ink_secondary":  "#9A9AA3",
    "text_on_paper":          "#0F1013",
    "text_on_paper_secondary":"#5E5E66",
    "engine": {
      "C1": { "name": "Release Desk blue",   "hex": "#3D7BFF" },
      "C2": { "name": "Rankings yellow",     "hex": "#FFD23F" },
      "C3": { "name": "Market green",        "hex": "#21D07A" },
      "C4": { "name": "Commentary pink",     "hex": "#FF3E9B" }
    },
    "semantic": {
      "up_cop":    "#21D07A",
      "hold_wait": "#FFB020",
      "down_pass": "#FF3B30"
    }
  },
  "type": {
    "display": { "family": "Bebas Neue", "file": "fonts/bebasneue/BebasNeue-Regular.ttf", "licence": "SIL OFL 1.1", "case": "caps only" },
    "body":    { "family": "Inter",      "file": "fonts/inter/Inter[opsz,wght].ttf",       "licence": "SIL OFL 1.1", "weights": [400, 500, 600, 700] },
    "mono":    { "family": "IBM Plex Mono", "file": "fonts/ibmplexmono/IBMPlexMono-{Regular,Medium,Bold}.ttf", "licence": "SIL OFL 1.1" },
    "scale_px_on_1080": {
      "display_xxl": 240, "display_xl": 168, "display_l": 120, "display_m": 88, "display_s": 64,
      "body_l": 44, "body_m": 36, "body_s": 30, "body_xs": 26,
      "mono_l": 34, "mono_m": 30, "mono_s": 26
    },
    "line_height": { "display": 0.92, "body": 1.25, "mono": 1.3 },
    "tracking": { "display": "0.01em", "mono_caps": "0.12em" }
  },
  "surfaces": {
    "rule": "Paper wherever a photograph lives (product plates); Ink for hook, verdict, summary, data and commentary frames.",
    "plate": { "bg": "#FFFFFF", "border": "#E6E1D6", "border_w": 2, "radius": 24, "padding": 40, "no_shadow": true, "no_filter": true }
  },
  "motion": {
    "rule": "Cut-based. No dissolves over 200 ms. No generative motion. Still imagery only inside the house motion template (AI slots included).",
    "text_enter_ms": 120,
    "stamp_enter": { "scale_from": 1.15, "scale_to": 1.0, "ms": 150 },
    "beats_s": {
      "hook": 3.0,
      "item_hold": 4.0,
      "item_reveal_number_first": 0.4,
      "summary": 4.0,
      "end_card": 1.5,
      "c1_facts_block": 8.0,
      "c1_verdict_reveal": 3.0,
      "c1_reason_beat": 2.5,
      "c3_chart_draw": 3.0,
      "c3_data_point_hold": 2.5
    },
    "reel_band_s": { "min": 20, "target_min": 30, "target_max": 45, "max": 59, "never_over": 90 }
  },
  "audio": {
    "rule": "No voiceover. No AI voice. Music from the Instagram in-app royalty-free library, chosen at upload, logged in production/assets/audio_ledger.csv. Never the same track on both accounts within 14 days; never reused on one account within 14 days.",
    "distinct_tracks_in_rotation_minimum": 16,
    "distinct_tracks_in_rotation_recommended": 24
  }
}
